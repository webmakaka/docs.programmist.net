[Unit]
Description=docs.programmist.info

Requires=docker.service
After=docker.service

[Service]

Restart=always
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker kill docs.programmist.info
ExecStartPre=-/usr/bin/docker rm docs.programmist.info
ExecStartPre=-/usr/bin/docker pull marley/docs.programmist.info:latest
ExecStart=/bin/sh -c '/usr/bin/docker run --name docs.programmist.info   \
 -p 4006:80                        \
 marley/docs.programmist.info'
ExecStop=-/usr/bin/docker kill docs.programmist.info
ExecStop=-/usr/bin/docker rm docs.programmist.info

[Install]
WantedBy=multi-user.target
