[Unit]
Description=docs.programmist.net

Requires=docker.service
After=docker.service

[Service]

Restart=always
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker kill docs.programmist.net
ExecStartPre=-/usr/bin/docker rm docs.programmist.net
ExecStartPre=-/usr/bin/docker pull marley/docs.programmist.net:latest
ExecStart=/bin/sh -c '/usr/bin/docker run --name docs.programmist.net   \
 -p 4006:80                        \
 marley/docs.programmist.net'
ExecStop=-/usr/bin/docker kill docs.programmist.net
ExecStop=-/usr/bin/docker rm docs.programmist.net

[Install]
WantedBy=multi-user.target
